{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guaidao2/intelpwn/blob/main/schema/intelpwn.schema.json",
  "title": "IntelPwn JSON 输出 schema v1.1",
  "type": "object",
  "required": ["schema_version", "file", "path", "protections", "overflow", "format_string", "summary"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.1" },
    "file": { "type": ["string", "null"] },
    "path": { "type": ["string", "null"] },
    "protections": {
      "type": "object",
      "required": ["canary", "nx", "pie", "relro"],
      "properties": {
        "canary": { "type": ["boolean", "null"] },
        "nx": { "type": ["boolean", "null"] },
        "pie": { "type": ["boolean", "null"] },
        "relro": { "type": ["string", "null"], "enum": ["none", "partial", "full", null] },
        "shstk": { "type": ["boolean", "null"] },
        "ibt": { "type": ["boolean", "null"] },
        "cet": { "type": ["boolean", "null"] }
      }
    },
    "overflow": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "function": { "type": ["string", "null"] },
          "padding": { "type": ["integer", "null"] },
          "address": { "type": ["string", "null"] }
        }
      }
    },
    "format_string": {
      "type": "object",
      "properties": {
        "vulnerable": { "type": ["boolean", "null"] },
        "offset": { "type": ["integer", "null"] }
      }
    },
    "summary": {
      "type": "object",
      "required": ["count", "max_severity", "findings"],
      "properties": {
        "count": { "type": ["integer", "null"] },
        "max_severity": { "type": ["string", "null"] },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": ["string", "null"] },
              "detail": { "type": ["string", "null"] },
              "severity": { "type": ["string", "null"] },
              "exploitable": { "type": ["boolean", "null"] }
            }
          }
        }
      }
    },
    "cross_validation": {
      "type": "object",
      "properties": {
        "verdict": { "type": ["string", "null"] },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item": { "type": ["string", "null"] },
              "static": { "type": ["string", "integer", "null"] },
              "dynamic": { "type": ["string", "integer", "null"] },
              "state": { "type": ["string", "null"],
                         "enum": ["确认", "冲突", "未复现", "动态发现", "崩溃未关联", "canary", "跳过", null] },
              "note": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}
